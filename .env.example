# ── Required in production ────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, RDS, or local Docker).
# Leave empty locally to use the embedded PGlite database in ./.data
DATABASE_URL=
# Random 32+ char string. Signs cookies and email links: openssl rand -hex 32
TOKEN_SECRET=
# Public base URL used in emails and PDFs (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
APP_URL=http://localhost:3000
# Vercel Cron sends this as a Bearer token: openssl rand -hex 32
CRON_SECRET=
# Password for /admin (HTTP basic auth, any username)
ADMIN_PASSWORD=

# ── Recommended ───────────────────────────────────────────────────────
# Google PageSpeed Insights API key (free: 25,000 requests/day). Without it
# speed checks are often skipped because the keyless quota is tiny.
PSI_API_KEY=
# Resend API key. Without it, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="ExamWeb <reports@yourdomain.com>"
# Cloudflare Turnstile (bot protection). Without it, verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Development / testing only ────────────────────────────────────────
# EXAMWEB_DISABLE_PSI=1
# EXAMWEB_ALLOW_PRIVATE_TARGETS=1   # NEVER in production: disables SSRF protection
# Local testing only: raise free scan limits
# EXAMWEB_SCANS_PER_HOUR=200
# EXAMWEB_SCANS_PER_DAY=1000
